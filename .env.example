NEXT_PUBLIC_SUPABASE_URL="YOUR_SUPABASE_URL_HERE"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY_HERE"

# Server-only. From Supabase dashboard -> Project Settings -> API -> service_role.
# Never prefix this with NEXT_PUBLIC_ — it bypasses Row Level Security entirely,
# which is exactly what the /admin pages need since admins are not Supabase
# Auth users at all.
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE"

# The /admin login. A separate, shared credential — deliberately not tied to
# any member's account, so admin access does not depend on one person's
# Google/email login.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="CHANGE_ME_BEFORE_DEPLOYING"

# Email-code sign-in (/api/auth/send-otp, verify-otp). Sends via Gmail SMTP
# rather than Supabase's built-in mailer — see supabase/migrations/0005 and
# the "otp feature.md" design notes for why. Use an app password, not the
# account's real password: Google Account -> Security -> 2-Step Verification
# -> App passwords.
GMAIL_USER="your_sender@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"
EMAIL_FROM_NAME="CESA"

# Encrypts the OTP session payload that round-trips through the browser
# between send and verify. Any long random string; generate one with
# `openssl rand -base64 32`. Falls back to SUPABASE_SERVICE_ROLE_KEY if unset,
# but set a dedicated value before deploying — reusing the service-role key
# for this is only meant to unblock local setup.
OTP_ENCRYPTION_SECRET="CHANGE_ME_BEFORE_DEPLOYING"
